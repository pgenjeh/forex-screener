# Copy ke .env untuk jalan lokal. JANGAN commit .env (sudah di .gitignore).
# Di Railway: isi yang sama di Project > Variables.

# --- Telegram (wajib untuk notif Telegram) ---
# Dari @BotFather di Telegram. Contoh: 123456789:AAEhBOweik6ad9r_QXMENQjcrGbqCr6yY54
TELEGRAM_BOT_TOKEN=
# ID chat kamu (angka). Dari @userinfobot, atau kirim pesan ke bot lalu cek getUpdates.
# Kalau mau kirim ke grup, pakai id grup (biasanya negatif, misal -1001234567890).
TELEGRAM_CHAT_ID=

# Jam kirim Telegram (WIB), pisah koma. Default scheduler: 07:00,19:30
TELEGRAM_TIMES=07:00,19:30

TZ=Asia/Jakarta
