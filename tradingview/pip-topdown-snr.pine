//@version=6
// =============================================================================
//  Pip Top-Down + SnR - indikator TradingView (Pine Script v6)
//  Logika SAMA dengan bot Telegram Pip Forex Screener (repo pgenjeh/forex-screener):
//    * Top-Down multi-timeframe: Weekly -> Daily -> H4 -> H1 -> M15
//      Skor per TF: harga vs EMA20/50/200, RSI14, momentum 5 bar,
//      posisi dalam range 20 bar. Bobot: W 30%, D 30%, H4 20%, H1 10%, M15 10%.
//    * Support & Resistance: swing high/low Daily (pivot 5 bar) yang
//      di-cluster jadi zona (toleransi 0.5 x ATR Daily). Touches = jumlah
//      pengujian level. Garis digambar untuk 2 Support + 2 Resistance terdekat.
//    * Eksekusi: searah bias Top-Down, tunggu konfirmasi H1/M15 di dekat level.
//
//  CARA PASANG: TradingView -> Pine Editor -> New -> paste file ini -> "Add to chart"
//  CHART YANG DISARANKAN: M15 (supaya semua 5 TF kebaca). Di chart H1, M15
//  tampil "-"; di chart Daily, H4/H1/M15 tampil "-" (Pine tidak bisa ambil
//  timeframe yang LEBIH RENDAH dari timeframe chart). Bobot dihitung ulang
//  otomatis dari TF yang tersedia.
//  CATATAN: level pivot Daily baru terkonfirmasi 5 bar Daily setelah terbentuk
//  (delay wajar). lookahead dimatikan -> tidak repaint pada data terkonfirmasi.
// =============================================================================
indicator("Pip Top-Down + SnR", shorttitle="Pip TD-SnR", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=1000)

// ---------------------------------------------------------------- inputs
pivotBars  = input.int(5, "Pivot kiri/kanan (bar Daily)", minval=1, maxval=20)
atrMult    = input.float(0.5, "Toleransi cluster level (x ATR Daily)", minval=0.1, maxval=2.0, step=0.1)
maxLevels  = input.int(10, "Maks level S/R disimpan", minval=2, maxval=30)
showTable  = input.bool(true, "Tampilkan tabel Top-Down")
showSR     = input.bool(true, "Gambar garis S/R di chart")

// ---------------------------------------------------------------- helpers
f_score() =>
    e20 = ta.ema(close, 20)
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    r = ta.rsi(close, 14)
    chg5 = (close / close[5] - 1) * 100
    hi20 = ta.highest(high, 20)
    lo20 = ta.lowest(low, 20)
    pos20 = (close - lo20) / (hi20 - lo20) * 100
    s = 0.0
    s += (close > e50 ? 25 : -25)
    s += (close > e20 ? 15 : -15)
    s += (e20 > e50 ? 10 : -10)
    s += (close > e200 ? 10 : -10)
    s += math.max(-15, math.min(15, (r - 50) * 0.5))
    s += math.max(-10, math.min(10, chg5 * 2))
    s += math.max(-10, math.min(10, (pos20 - 50) * 0.2))
    math.max(-100, math.min(100, s))

f_arrow(v) => na(v) ? "-" : v >= 25 ? "^" : v <= -25 ? "v" : "*"

f_txt(v, fmt) => na(v) ? "-" : str.tostring(v, fmt)

f_col(v) => na(v) ? color.gray : v >= 25 ? color.green : v <= -25 ? color.red : color.gray

// ---------------------------------------------------------------- skor per TF
[sW, rsiW]     = request.security(syminfo.tickerid, "W",   [f_score(), ta.rsi(close, 14)], lookahead=barmerge.lookahead_off)
[sD, rsiD]     = request.security(syminfo.tickerid, "D",   [f_score(), ta.rsi(close, 14)], lookahead=barmerge.lookahead_off)
[sH4, rsiH4]   = request.security(syminfo.tickerid, "240", [f_score(), ta.rsi(close, 14)], lookahead=barmerge.lookahead_off)
[sH1, rsiH1]   = request.security(syminfo.tickerid, "60",  [f_score(), ta.rsi(close, 14)], lookahead=barmerge.lookahead_off)
[sM15, rsiM15] = request.security(syminfo.tickerid, "15",  [f_score(), ta.rsi(close, 14)], lookahead=barmerge.lookahead_off)

// Skor tertimbang (bobot dihitung ulang dari TF yang tersedia saja)
wSum = 0.0
wTot = 0.0
bull = 0
bear = 0
if not na(sW)
    wSum += 0.30 * sW
    wTot += 0.30
    bull += (sW >= 25 ? 1 : 0)
    bear += (sW <= -25 ? 1 : 0)
if not na(sD)
    wSum += 0.30 * sD
    wTot += 0.30
    bull += (sD >= 25 ? 1 : 0)
    bear += (sD <= -25 ? 1 : 0)
if not na(sH4)
    wSum += 0.20 * sH4
    wTot += 0.20
    bull += (sH4 >= 25 ? 1 : 0)
    bear += (sH4 <= -25 ? 1 : 0)
if not na(sH1)
    wSum += 0.10 * sH1
    wTot += 0.10
    bull += (sH1 >= 25 ? 1 : 0)
    bear += (sH1 <= -25 ? 1 : 0)
if not na(sM15)
    wSum += 0.10 * sM15
    wTot += 0.10
    bull += (sM15 >= 25 ? 1 : 0)
    bear += (sM15 <= -25 ? 1 : 0)

nTF = (na(sW) ? 0 : 1) + (na(sD) ? 0 : 1) + (na(sH4) ? 0 : 1) + (na(sH1) ? 0 : 1) + (na(sM15) ? 0 : 1)
wScore = wTot > 0 ? int(math.round(wSum / wTot)) : 0
bias = wScore >= 25 ? "Bullish" : wScore <= -25 ? "Bearish" : "Mixed"
aligned = str.tostring(math.max(bull, bear)) + "/" + str.tostring(nTF)

// ---------------------------------------------------------------- S/R Daily
atrD = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead=barmerge.lookahead_off)
phD  = request.security(syminfo.tickerid, "D", ta.pivothigh(high, pivotBars, pivotBars), lookahead=barmerge.lookahead_off)
plD  = request.security(syminfo.tickerid, "D", ta.pivotlow(low, pivotBars, pivotBars), lookahead=barmerge.lookahead_off)

var float[] rLevels = array.new_float()
var int[]   rTouch  = array.new_int()
var float[] sLevels = array.new_float()
var int[]   sTouch  = array.new_int()

// Tambah level baru, atau gabung ke zona yang sudah ada (touches +1)
f_addLevel(float[] levels, int[] touches, float price, float tol) =>
    idx = -1
    for i = 0 to array.size(levels) - 1
        if math.abs(array.get(levels, i) - price) <= tol
            idx := i
            break
    if idx >= 0
        old = array.get(levels, idx)
        n = array.get(touches, idx)
        array.set(levels, idx, (old * n + price) / (n + 1))
        array.set(touches, idx, n + 1)
    else
        array.push(levels, price)
        array.push(touches, 1)

// Buang level terjauh dari harga kalau sudah melebihi batas
f_prune(float[] levels, int[] touches, int maxN) =>
    while array.size(levels) > maxN
        far = 0
        farD = -1.0
        for i = 0 to array.size(levels) - 1
            d = math.abs(array.get(levels, i) - close)
            if d > farD
                farD := d
                far := i
        array.remove(levels, far)
        array.remove(touches, far)

tol = nz(atrD, 0) * atrMult
newPh = not na(phD) and (na(phD[1]) or phD != phD[1])
newPl = not na(plD) and (na(plD[1]) or plD != plD[1])
if newPh and tol > 0
    f_addLevel(rLevels, rTouch, phD, tol)
    f_prune(rLevels, rTouch, maxLevels)
if newPl and tol > 0
    f_addLevel(sLevels, sTouch, plD, tol)
    f_prune(sLevels, sTouch, maxLevels)

// Cari 2 level terdekat di satu sisi (true = Resistance, false = Support)
// Return: [harga1, touches1, harga2, touches2]
f_nearest(float[] levels, int[] touches, bool isRes) =>
    bestP = float(na)
    bestT = 0
    bestD = 1e308
    best2P = float(na)
    best2T = 0
    best2D = 1e308
    for i = 0 to array.size(levels) - 1
        p = array.get(levels, i)
        t = array.get(touches, i)
        ok = isRes ? p > close : p < close
        if ok
            d = isRes ? p - close : close - p
            if d < bestD
                best2P := bestP
                best2T := bestT
                best2D := bestD
                bestP := p
                bestT := t
                bestD := d
            else if d < best2D
                best2P := p
                best2T := t
                best2D := d
    [bestP, bestT, best2P, best2T]

[r1, r1t, r2, r2t] = f_nearest(rLevels, rTouch, true)
[s1, s1t, s2, s2t] = f_nearest(sLevels, sTouch, false)

f_distPct(lv) => na(lv) ? float(na) : (lv / close - 1) * 100
f_distAtr(lv) => na(lv) or na(atrD) or atrD == 0 ? float(na) : math.abs(lv - close) / atrD

status = "mid-range"
if not na(s1) and not na(f_distAtr(s1)) and f_distAtr(s1) <= 0.5
    status := "di Support"
else if not na(r1) and not na(f_distAtr(r1)) and f_distAtr(r1) <= 0.5
    status := "di Resistance"
else if na(r1)
    status := "tanpa Resistance dekat"
else if na(s1)
    status := "tanpa Support dekat"

// ---------------------------------------------------------------- gambar garis S/R
var line[] rLines = array.new_line()
var line[] sLines = array.new_line()
var label[] rLabels = array.new_label()
var label[] sLabels = array.new_label()

f_drawLevel(line[] lines, label[] labels, float lv, int touches, color col, string tag) =>
    if not na(lv)
        ln = line.new(bar_index, lv, bar_index + 1, lv, xloc=xloc.bar_index, extend=extend.right, color=col, style=line.style_dashed, width=1)
        array.push(lines, ln)
        txt = tag + " " + str.tostring(lv, format.mintick) + " (" + (lv > close ? "+" : "") + str.tostring((lv / close - 1) * 100, "#.#") + "%, " + str.tostring(touches) + "x)"
        lb = label.new(bar_index, lv, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(col, 0), textcolor=color.white, size=size.small)
        array.push(labels, lb)

if barstate.islast and showSR
    for l in rLines
        line.delete(l)
    for l in sLines
        line.delete(l)
    for lb in rLabels
        label.delete(lb)
    for lb in sLabels
        label.delete(lb)
    array.clear(rLines)
    array.clear(sLines)
    array.clear(rLabels)
    array.clear(sLabels)
    f_drawLevel(rLines, rLabels, r1, r1t, color.red, "R")
    f_drawLevel(rLines, rLabels, r2, r2t, color.new(color.red, 60), "R")
    f_drawLevel(sLines, sLabels, s1, s1t, color.green, "S")
    f_drawLevel(sLines, sLabels, s2, s2t, color.new(color.green, 60), "S")

// ---------------------------------------------------------------- tabel Top-Down
var table td = table.new(position.top_right, 4, 11, border_width=1)

f_cell(int col, int row, string txt, color bg) =>
    table.cell(td, col, row, txt, text_color=color.white, bgcolor=bg, text_size=size.small)

if barstate.islast and showTable
    table.cell(td, 0, 0, "PIP TOP-DOWN + SnR * " + syminfo.ticker, text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=size.small)
    table.merge_cells(td, 0, 0, 3, 0)
    table.cell(td, 0, 1, "TF", text_color=color.white, bgcolor=color.new(color.gray, 0), text_size=size.small)
    table.cell(td, 1, 1, "Arah", text_color=color.white, bgcolor=color.new(color.gray, 0), text_size=size.small)
    table.cell(td, 2, 1, "Skor", text_color=color.white, bgcolor=color.new(color.gray, 0), text_size=size.small)
    table.cell(td, 3, 1, "RSI", text_color=color.white, bgcolor=color.new(color.gray, 0), text_size=size.small)
    f_cell(0, 2, "Weekly", color.new(color.gray, 70))
    f_cell(1, 2, f_arrow(sW), f_col(sW))
    f_cell(2, 2, f_txt(sW, "#"), f_col(sW))
    f_cell(3, 2, f_txt(rsiW, "#.#"), color.new(color.gray, 70))
    f_cell(0, 3, "Daily", color.new(color.gray, 70))
    f_cell(1, 3, f_arrow(sD), f_col(sD))
    f_cell(2, 3, f_txt(sD, "#"), f_col(sD))
    f_cell(3, 3, f_txt(rsiD, "#.#"), color.new(color.gray, 70))
    f_cell(0, 4, "H4", color.new(color.gray, 70))
    f_cell(1, 4, f_arrow(sH4), f_col(sH4))
    f_cell(2, 4, f_txt(sH4, "#"), f_col(sH4))
    f_cell(3, 4, f_txt(rsiH4, "#.#"), color.new(color.gray, 70))
    f_cell(0, 5, "H1", color.new(color.gray, 70))
    f_cell(1, 5, f_arrow(sH1), f_col(sH1))
    f_cell(2, 5, f_txt(sH1, "#"), f_col(sH1))
    f_cell(3, 5, f_txt(rsiH1, "#.#"), color.new(color.gray, 70))
    f_cell(0, 6, "M15", color.new(color.gray, 70))
    f_cell(1, 6, f_arrow(sM15), f_col(sM15))
    f_cell(2, 6, f_txt(sM15, "#"), f_col(sM15))
    f_cell(3, 6, f_txt(rsiM15, "#.#"), color.new(color.gray, 70))
    table.cell(td, 0, 7, "Bias: " + bias + " (" + str.tostring(wScore) + ") * Selaras " + aligned, text_color=color.white, bgcolor=f_col(wScore), text_size=size.small)
    table.merge_cells(td, 0, 7, 3, 7)
    sTxt = "S: " + (na(s1) ? "-" : str.tostring(s1, format.mintick) + " (" + str.tostring(f_distPct(s1), "#.#") + "%, " + str.tostring(s1t) + "x)")
    rTxt = "R: " + (na(r1) ? "-" : str.tostring(r1, format.mintick) + " (" + str.tostring(f_distPct(r1), "#.#") + "%, " + str.tostring(r1t) + "x)")
    table.cell(td, 0, 8, sTxt, text_color=color.white, bgcolor=color.new(color.green, 30), text_size=size.small)
    table.merge_cells(td, 0, 8, 3, 8)
    table.cell(td, 0, 9, rTxt, text_color=color.white, bgcolor=color.new(color.red, 30), text_size=size.small)
    table.merge_cells(td, 0, 9, 3, 9)
    table.cell(td, 0, 10, "Status: " + status, text_color=color.white, bgcolor=color.new(color.gray, 0), text_size=size.small)
    table.merge_cells(td, 0, 10, 3, 10)

// ---------------------------------------------------------------- alerts
nearSup = not na(s1) and not na(f_distAtr(s1)) and f_distAtr(s1) <= 0.5
nearRes = not na(r1) and not na(f_distAtr(r1)) and f_distAtr(r1) <= 0.5
alertcondition(nearSup, title="Pip: Harga di Support", message="Pip TD-SnR: {{ticker}} mendekati Support (<=0.5 ATR). Harga {{close}}.")
alertcondition(nearRes, title="Pip: Harga di Resistance", message="Pip TD-SnR: {{ticker}} mendekati Resistance (<=0.5 ATR). Harga {{close}}.")
alertcondition(bias == "Bullish" and bias[1] != "Bullish", title="Pip: Bias jadi Bullish", message="Pip TD-SnR: {{ticker}} bias Top-Down berubah jadi Bullish.")
alertcondition(bias == "Bearish" and bias[1] != "Bearish", title="Pip: Bias jadi Bearish", message="Pip TD-SnR: {{ticker}} bias Top-Down berubah jadi Bearish.")
